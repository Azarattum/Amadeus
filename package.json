{
  "name": "amadeus",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/tailwind/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "rimraf build && turbo run build --parallel --no-daemon",
    "clean": "rimraf build */*/coverage",
    "coverage": "turbo run coverage --parallel --no-daemon",
    "dev": "turbo run dev --parallel --filter !libfun --filter !@amadeus-music/util --no-daemon",
    "preview": "turbo run preview --parallel --no-daemon",
    "test": "turbo run test --parallel --no-daemon"
  },
  "devDependencies": {
    "@sveltejs/kit": "2.5.17",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/node": "20.14.9",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.27",
    "cssnano": "^7.1.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-svelte": "^2.46.1",
    "postcss": "^8.5.8",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-sort-imports": "^1.8.11",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^5.0.10",
    "rollup": "^4.60.1",
    "rollup-plugin-node-externals": "^7.1.3",
    "svelte": "^4.2.20",
    "svelte-check": "^3.8.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-contain": "^0.1.1",
    "tslib": "^2.8.1",
    "turbo": "^2.9.3",
    "typescript": "^5.5.2",
    "vite": "^5.4.21",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0"
  },
  "packageManager": "pnpm@10.33.0"
}
